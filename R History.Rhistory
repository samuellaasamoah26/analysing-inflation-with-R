#### GHANA'S CPI
install.packages(c("readr", "dplyr", "tibble"))
library("readr" , "dplyr", "tibble")
install.packages("tbble")
install.packages("tibble")
library(tibble)
library(readxl)
CPI_20261125_103744 <- read_excel("01 Raw Data/CPI_20261125-103744.xlsx",
col_types = c("text", "text", "numeric",
"numeric", "numeric"))
View(CPI_20261125_103744)
cpi_data <- `CPI 20261125 103754`
dim(cpi_data)
cpi_data <- `CPI_20261125_103744`
dim(cpi_data)
str(cpi_data)
head(cpi_data)
unique(cpi_data$Items)
names(cpi_data)
names(cpi_data)
class(cpi_data)
colnames(cpi_data)
unique(cpi_data[[2]])
unique(cpi_data[[2]])
headline <- cpi_data[cpi_data[[2]] == "All products", ]
dim(headline)
max(headline[[3]], na.rm = TRUE)
min(headline[[3]], na.rm = TRUE)
headline[which.min(headline[[3]]), ]
headline[which.max(headline[[3]]), ]
headline[which.max(headline[[3]]), ]
head(headline$Month)
head(headline[[1]])
names(headline)
headline$month_date <- as.Date(paste0(
substr(headline$months, 1, 4), "-",
substr(headline$months, 6, 7), "-01"
))
head(headline$month_date)
head(headline$month_date)
headline <- headline[order(headline$month_date), ]
tail(headline$month_date)
headline <- headline[order(headline$month_date), ]
head(headline$month_date)
headline <- headline[headline$month_date >= as.Date("1999-01-01") &
!is.na(headline$all_sources), ]
head(headline$month_date)
dim(headline)
library(ggplot2)
library(ggplot2)
installed.packages()[, "Package"]
plot(headline$month_date, headline$all_sources,
type = "l",
main = "Ghana Headline Inflation (1999–2026)",
xlab = "Year",
ylab = "Inflation Rate (%)")
mean(headline$all_sources, na.rm = TRUE)
